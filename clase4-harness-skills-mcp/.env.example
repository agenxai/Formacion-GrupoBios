# ──────────────────────────────────────────────────────────────────────
# Clase 4 · Harness, Skills y MCP — plantilla de configuración
# Copia este archivo a .env y completa los valores. NUNCA subas .env al git.
# ──────────────────────────────────────────────────────────────────────

# Ruta a la base sintética bios_ops.db (reutilizada de la clase 1).
# Por defecto apunta al original; si prefieres una copia local, ajusta la ruta.
BIOS_DB_PATH=../clase1-lab-agentes/bios_ops.db

# ── RAG · OpenAI Vector Store (no se construye RAG local) ─────────────
# El corpus de documentos de Bios ya está indexado en este vector store de
# OpenAI. La Skill solo recupera — no indexa. El ID ya viene configurado por
# defecto; sólo necesitas proporcionar tu OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_VECTOR_STORE_ID=vs_6a7dc97b07ac8191aa9240583a27c133

# Número de fragmentos a recuperar del vector store.
RAG_TOP_K=4

# ── Cierre n8n (instancia n8n de la AGENCIA, no de Bios) ──────────────
N8N_API_URL=
N8N_API_KEY=

# ── MCP de Google Sheets/Drive (cuenta Google de la AGENCIA) ──────────
# ID de la hoja de prueba "Seguimiento Demo Clase 4 Bios".
GOOGLE_SHEETS_DEMO_ID=

# ── Harness (OpenCode por ADR-001) ────────────────────────────────────
# La auth del LLM subyacente del harness vive en el archivo de config del
# harness, NO en este .env. Consulta INSTALL-HARNESS-N8N-CLI.md §5.
# Las variables de arriba son las que los scripts de tools/ leen directamente.

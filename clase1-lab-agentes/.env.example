# ==============================================================================
#  Laboratorio "Niveles de Agencia" — Clase 1
#  Grupo Bios · Programa Qypher
# ==============================================================================
#
#  CÓMO USAR ESTE ARCHIVO
#    1. Cópialo:  cp .env.example .env
#    2. Edita .env y pega tu API key en OPENAI_API_KEY
#    3. NUNCA subas .env a git (ya está en .gitignore)
#
#  Este archivo (.env.example) SÍ se versiona, pero solo con valores de ejemplo.
#  Si alguna vez ves una key real acá, es un incidente de seguridad: rótala.
# ==============================================================================


# ------------------------------------------------------------------------------
#  1. CREDENCIALES  (lo único obligatorio)
# ------------------------------------------------------------------------------

# Tu API key de OpenAI. Se obtiene en https://platform.openai.com/api-keys
# Si la dejas vacía, el laboratorio arranca igual en MODO=replay (ver sección 3).
OPENAI_API_KEY=sk-proj-reemplaza-esto-con-tu-key


# ------------------------------------------------------------------------------
#  2. MODELO
# ------------------------------------------------------------------------------

# Modelo usado por los cinco niveles.
#
# ⚠ ANTES DE LA CLASE: confirma qué modelos están habilitados en la cuenta de
#   OpenAI que van a usar y con qué límites de peticiones por minuto. El valor
#   de abajo es un default razonable y económico, no una verdad de tu cuenta.
OPENAI_MODEL=gpt-4o-mini

# Modelo solo para el supervisor del nivel 5. Vacío = usa el mismo de arriba.
# Útil para mostrar en clase que un supervisor puede usar un modelo mayor que
# sus sub-agentes.
MODELO_SUPERVISOR=


# ------------------------------------------------------------------------------
#  3. MODO DE EJECUCIÓN
# ------------------------------------------------------------------------------

# vivo   = siempre llama a la API de OpenAI
# replay = nunca llama; reproduce trazas pregrabadas (funciona sin internet)
# auto   = vivo si hay key y no se excedió el tope; si no, cae a replay
#
# Recomendado para clase: auto
MODO=auto


# ------------------------------------------------------------------------------
#  4. CONTROL DE COSTO Y DE LA API COMPARTIDA
# ------------------------------------------------------------------------------

# Gasto máximo acumulado en dólares. Al alcanzarlo el sistema conmuta a replay
# y avisa; no se cae. Acuérdalo con quien paga la cuenta.
TOPE_USD=10.00

# Llamadas simultáneas máximas a la API. Protege una key compartida entre
# varias personas: sin esto, 15 personas ejecutando a la vez producen errores
# 429 en cascada. Ajústalo hacia abajo si la cuenta tiene límites estrictos.
MAX_CONCURRENCIA=4

# Caché de respuestas en disco. Con datos deterministas y preguntas
# precargadas, 15 personas haciendo la misma pregunta cuestan UNA llamada.
# Ponlo en false solo si quieres demostrar la ejecución real en vivo.
CACHE_ACTIVO=true

# ⚠ Tarifas del modelo, en dólares por millón de tokens.
#   VERIFÍCALAS en la página de precios de OpenAI para el modelo que elegiste.
#   Un costo mal calculado en pantalla es peor que no mostrarlo: el grupo va a
#   tomar decisiones de arquitectura mirando ese número.
PRECIO_ENTRADA_POR_1M=0.00
PRECIO_SALIDA_POR_1M=0.00


# ------------------------------------------------------------------------------
#  5. DATOS
# ------------------------------------------------------------------------------

# Semilla del generador de datos sintéticos. Con un valor fijo, la base es
# idéntica en todas las máquinas: la demo del facilitador coincide con lo que
# ve cada participante y el caché sirve para todos.
# Cambiarla invalida el caché y las trazas de replay.
SEMILLA_DATOS=42

# Fecha de referencia (YYYY-MM-DD) desde la que se generan los datos hacia
# atrás. Vacío = hoy. Fíjala si quieres que "esta semana" signifique lo mismo
# el día de la prueba y el día de la clase.
FECHA_REFERENCIA=


# ------------------------------------------------------------------------------
#  6. RED
# ------------------------------------------------------------------------------

# Puertos publicados en el equipo. Cámbialos si ya los tienes ocupados.
PUERTO_TABLERO=8000
PUERTO_NOTEBOOK=8888

# ⚠ Los puertos se publican SOLO en 127.0.0.1 (ver docker-compose.yml).
#   El endpoint que edita los system prompts no tiene autenticación y Jupyter
#   corre sin token: son herramientas de demo en red local. No expongas estos
#   puertos a la red de la oficina.

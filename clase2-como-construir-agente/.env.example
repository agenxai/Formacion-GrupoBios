# Configuración del agente · Azure OpenAI de Bios.
# Copia este archivo a `.env` (en la raíz clase2-como-construir-agente/) y completa
# los valores. El .gitignore ya excluye `.env` —nUNCA lo subas al repo.

# --- Obligatorias ---
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=<pega-aqui-tu-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# --- Opcionales ---
AZURE_OPENAI_API_VERSION=2024-10-21

# Ruta a la base de datos. Por defecto busca bios_ops.db en agente-transparente/.
# Si la copiaste en otro sitio (o regeneraste la de la clase 1), apunta acá:
# BIOS_DB_PATH=/ruta/absoluta/bios_ops.db
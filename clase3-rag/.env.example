# ──────────────────────────────────────────────────────────────────────────
# Clase 3 · RAG — Configuración del entorno.
#
# Este archivo se versiona. El real `.env` (con credenciales) NO se versiona
# y se genera con `cp .env.example .env`. Ver spec 02 § "Variables de entorno".
# ──────────────────────────────────────────────────────────────────────────

# ▸ App visual (container local del tablero) — solo el webhook es "en vivo"
# Sin esta variable, la pantalla 7 muestra un mensaje explicativo y NO
# intenta la llamada (spec 04 CA-7.5).
N8N_WEBHOOK_URL=

# Puerto local donde el tablero escucha. Cámbielo si 8000 está ocupado.
PUERTO_TABLERO=8000

# ▸ Pre-bakeo (solo se usa UNA VEZ en pre-prod, spec 02 ADR-001, spec 03).
# NO se necesitan para correr la app — solo para regenerar app/data/*.json.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Semilla del corpus + UMAP. Fija = data idéntica en todas las máquinas.
SEMILLA_DATOS=42
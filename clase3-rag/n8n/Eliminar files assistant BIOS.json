        "jsCode": "// Script para n8n que extrae los file IDs de un JSON y los devuelve como elementos individuales\n\n// Obtener los datos de entrada\nconst inputData = items[0].json;\n\n// Verificar si los datos tienen la estructura esperada\nif (!inputData || !inputData.data || !Array.isArray(inputData.data)) {\n  throw new Error('El formato de entrada no es válido. Se espera un objeto con una propiedad \"data\" que sea un array.');\n}\n\n// Extraer solo los IDs de los archivos\nconst fileIds = inputData.data.map(file => file.id);\n\n// Crear un array de items donde cada item contiene un ID\nconst returnItems = [];\n\nfor (const id of fileIds) {\n  returnItems.push({\n    json: {\n      fileId: id\n    }\n  });\n}\n\n// n8n espera que se retorne este array de items\nreturn returnItems;"
